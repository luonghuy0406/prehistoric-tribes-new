{
  "name": "prehistoric-tribes-3d",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/data --noEmit && tsc -p packages/engine-adapter --noEmit && tsc -p packages/render2d --noEmit && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "dev": "npm run dev -w @pt3d/web",
    "build": "npm run build -w @pt3d/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4"
  }
}
